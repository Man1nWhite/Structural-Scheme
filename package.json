{
  "name": "structural-scheme",
  "private": true,
  "description": "Генератор структурных схем АСУ ТП (один HTML-файл без сборки в браузере)",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o src/styles.css --minify",
    "vendor": "node scripts/vendor.js",
    "start": "node scripts/serve.js"
  },
  "devDependencies": {
    "htm": "3.1.1",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19"
  }
}
